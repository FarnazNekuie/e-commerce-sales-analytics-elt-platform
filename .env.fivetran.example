# Fivetran REST API credentials used by the Airflow DAG.
FIVETRAN_API_KEY=replace_with_your_api_key
FIVETRAN_API_SECRET=replace_with_your_api_secret
FIVETRAN_CONNECTION_ID=replace_with_your_connection_id

# Neon/PostgreSQL source connection values.
PGHOST=your-neon-hostname.neon.tech
PGPORT=5432
PGDATABASE=olist_source
PGUSER=fivetran_user
PGPASSWORD=replace_with_a_secure_password
PGSSLMODE=require
